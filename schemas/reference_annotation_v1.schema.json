{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ethmac.local/schema/reference_annotation_v1.json",
  "title": "Blind reference annotation v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_id",
    "annotator_id",
    "decision_status",
    "best_action",
    "acceptable_actions",
    "confidence",
    "evidence_ids",
    "rationale_codes",
    "ambiguity_reason"
  ],
  "properties": {
    "schema_version": {"const": "reference_annotation_v1"},
    "record_id": {"type": "string", "minLength": 1},
    "annotator_id": {"type": "string", "minLength": 1},
    "decision_status": {"enum": ["labeled", "abstain"]},
    "best_action": {
      "type": ["string", "null"],
      "enum": ["stay", "wait", "search_buy", "search_jeonse", "search_monthly_rent", "list_for_sale", "list_for_rent", null]
    },
    "acceptable_actions": {
      "type": "array",
      "uniqueItems": true,
      "items": {"enum": ["stay", "wait", "search_buy", "search_jeonse", "search_monthly_rent", "list_for_sale", "list_for_rent"]}
    },
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "evidence_ids": {"type": "array", "maxItems": 5, "uniqueItems": true, "items": {"type": "string"}},
    "rationale_codes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "uniqueItems": true,
      "items": {"enum": ["AFFORDABILITY", "LIQUIDITY", "RISK", "GOAL_FIT", "EVIDENCE", "MEMORY", "UNCERTAINTY", "LEGALITY"]}
    },
    "ambiguity_reason": {"type": ["string", "null"]}
  }
}
