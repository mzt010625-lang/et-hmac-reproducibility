{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Stage 8G candidate-only JEV",
  "type": "object",
  "additionalProperties": false,
  "required": ["v", "id", "should_escalate", "need_l2_probability", "reason_code", "confidence", "evidence"],
  "properties": {
    "v": {"const": "jev_candidate_verifier_v1"},
    "id": {"type": "string", "minLength": 1},
    "should_escalate": {"type": "boolean"},
    "need_l2_probability": {"type": "number", "minimum": 0, "maximum": 1},
    "reason_code": {"enum": ["MARKET_ZERO", "RECENT_FAILURE", "CONFLICT_WAIT", "POLICY_AMBIGUITY", "NO_VALID_EXCEPTION"]},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "evidence": {"type": "array", "maxItems": 3, "uniqueItems": true, "items": {"type": "string"}}
  }
}
