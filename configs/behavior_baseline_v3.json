{
  "config_version": "behavior_baseline_v3",
  "provider": "DeepSeek official API",
  "base_url": "https://api.deepseek.com",
  "chat_completions_path": "/chat/completions",
  "model": "deepseek-flash",
  "temperature": 0.0,
  "max_tokens": 4096,
  "timeout_seconds": 180,
  "max_attempts": 3,
  "retry_status_codes": [408, 425, 429, 500, 502, 503, 504],
  "retry_backoff_seconds": [2, 8, 20],
  "stream": false,
  "response_format_json_object": true,
  "thinking": {"type": "disabled"},
  "audits_per_record": 2,
  "formal_evaluation_eligible": false,
  "repeatability_target": 0.97,
  "maximum_single_action_share": 0.80,
  "notes": "Development stability baseline. The 4096-token ceiling is truncation protection; billing uses actual output. Accuracy requires independent labels. JEV optimization is forbidden until this baseline passes repeatability and non-collapse gates."
}
